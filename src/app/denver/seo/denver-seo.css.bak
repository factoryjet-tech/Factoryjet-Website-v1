/* ─────────────────────────────────────────────────────────────────────────────
   /us/denver/seo - "The Altitude Advantage" Denver local-SEO page styles.
   Sapphire-blue palette (trust/confidence) over the locked FactoryJet system:
   brand fonts via next/font vars, scoped under .dseo. Distinct LAYOUT from Austin
   (Glass Depth Stack), Charlotte, Nashville, Tampa. Zero page JS: industry tabs
   are CSS-only (radio :checked), market stats are static maxi-stats, FAQ is the
   canonical .faqnav + native <details> pattern shared across every city page.
   Perf target 100/100: fixed-height visuals (zero CLS), motion behind
   prefers-reduced-motion, content visible by default. No em dashes in copy.
───────────────────────────────────────────────────────────────────────────── */
.dseo{
  --blue:#2563EB;--blue-d:#1D4ED8;--blue-soft:#E8EFFD;--sky:#3B82F6;--sky-l:#60A5FA;
  --cream:#FAFBFE;--paper:#FFFFFF;--ink:#0E1B33;--n700:#33415C;--n600:#51607A;--n400:#73809B;
  --navy:#0F172A;--navy2:#16223D;--ct:#EAF1FD;--ct-mut:#94A3B8;
  --green:#15803D;--green-soft:#DCFCE7;--amber-soft:#FEF3C7;--amber-d:#B45309;
  --line:rgba(14,27,51,.10);--line-d:rgba(14,27,51,.18);
  --e-out:cubic-bezier(.23,1,.32,1);
  --sh-card:0 22px 44px -24px rgba(14,27,51,.22);
  --disp:var(--font-plus-jakarta),system-ui,sans-serif;
  --body:var(--font-inter),system-ui,sans-serif;
  --mono:var(--font-geist-mono),ui-monospace,monospace;
  background:var(--cream);color:var(--ink);font-family:var(--body);line-height:1.62;-webkit-font-smoothing:antialiased;overflow-x:clip;
}
.dseo *{box-sizing:border-box}
.dseo h1,.dseo h2,.dseo h3,.dseo p,.dseo blockquote{margin:0}
.dseo h1,.dseo h2,.dseo h3{font-family:var(--disp);font-weight:700;line-height:1.1;letter-spacing:-.025em;text-wrap:balance;color:var(--ink)}
.dseo h2{font-size:clamp(28px,3.6vw,44px);margin-bottom:14px}
.dseo h3{font-size:19px}
.dseo .wrap{max-width:1180px;margin:0 auto;padding:0 32px;position:relative;z-index:2}
.dseo .lead{font-size:18px;color:var(--n600);text-wrap:pretty}
.dseo .it{font-style:italic;color:var(--blue-d)}
.dseo .eyebrow{font-family:var(--mono);font-size:12px;font-weight:500;letter-spacing:.14em;text-transform:uppercase;display:inline-flex;align-items:center;gap:9px;color:var(--blue-d);margin-bottom:14px}
.dseo section{padding:84px 0}

/* buttons */
.dseo .btn{display:inline-flex;align-items:center;gap:9px;font-family:var(--body);font-weight:700;font-size:15px;text-decoration:none;cursor:pointer;border-radius:13px;padding:15px 25px;transition:transform .2s var(--e-out),box-shadow .2s var(--e-out)}
.dseo .btn:active{transform:translateY(0) scale(.98)}
.dseo .btn-ghost{background:#fff;color:var(--ink);border:1.5px solid var(--line-d)}
.dseo .btn-ghost:hover{transform:translateY(-2px);border-color:var(--ink)}
.dseo .btn-ghost.on-dark{background:transparent;color:var(--ct);border-color:rgba(255,255,255,.22)}
.dseo .btn-ghost.on-dark:hover{border-color:#fff;color:#fff}
/* primary CTA: override ModalCTAButton inline orange -> Sapphire blue */
.dseo .dcta{background:linear-gradient(135deg,var(--blue),var(--sky))!important;color:#fff!important;border:none!important;box-shadow:0 14px 28px -10px rgba(37,99,235,.6)!important}
.dseo .dcta:hover{transform:translateY(-2px)}
.dseo .cta-row{display:flex;gap:14px;flex-wrap:wrap;align-items:center;margin-top:28px}
.dseo a:focus-visible,.dseo .btn:focus-visible,.dseo summary:focus-visible,.dseo .tab-label:focus-visible{outline:2px solid var(--blue);outline-offset:3px;border-radius:10px}

/* HERO */
.dseo .hero{min-height:100vh;background:var(--navy);display:flex;align-items:center;overflow:hidden;position:relative}
.dseo .dotgrid{background-image:radial-gradient(rgba(255,255,255,.05) 1px,transparent 1px);background-size:26px 26px}
.dseo .elev-bg{position:absolute;inset:0;pointer-events:none}.dseo .elev-bg svg{width:100%;height:100%}
.dseo .orb-1{position:absolute;top:8%;left:-5%;width:520px;height:520px;border-radius:50%;background:radial-gradient(circle,rgba(59,130,246,.22) 0%,transparent 65%);animation:dseo-drift 13s ease-in-out infinite alternate}
.dseo .orb-2{position:absolute;bottom:-12%;right:4%;width:600px;height:600px;border-radius:50%;background:radial-gradient(circle,rgba(37,99,235,.26) 0%,transparent 65%);animation:dseo-drift 17s ease-in-out infinite alternate-reverse}
@keyframes dseo-drift{from{transform:translate(0,0) scale(1)}to{transform:translate(30px,-20px) scale(1.05)}}
.dseo .hero-inner{position:relative;z-index:2;max-width:1180px;margin:0 auto;padding:0 32px;width:100%;display:grid;grid-template-columns:1fr 450px;gap:56px;align-items:center}
.dseo .hero-eyebrow{display:inline-flex;align-items:center;gap:10px;margin-bottom:26px;font-family:var(--mono);font-size:12px;letter-spacing:.12em;color:var(--sky-l);text-transform:uppercase}
.dseo .dot-pulse{width:8px;height:8px;border-radius:50%;background:var(--sky-l);animation:dseo-pulse 2s infinite}
@keyframes dseo-pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.5;transform:scale(.8)}}
.dseo .hero h1{font-size:clamp(38px,5vw,64px);font-weight:800;line-height:1.04;color:#fff;margin-bottom:24px;letter-spacing:-.03em}
.dseo .grad{background:linear-gradient(135deg,var(--sky-l) 0%,var(--blue) 55%,#93c5fd 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.dseo .hero-sub{font-size:18px;line-height:1.7;color:var(--ct-mut);margin-bottom:32px;max-width:480px}
.dseo .altitude-panel{background:rgba(255,255,255,.045);border:1px solid rgba(255,255,255,.09);border-radius:22px;padding:30px;position:relative;overflow:hidden}
.dseo .altitude-panel:before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,var(--blue),var(--sky-l),#93c5fd)}
.dseo .panel-title{font-family:var(--mono);font-size:11px;letter-spacing:.12em;color:var(--sky-l);text-transform:uppercase;margin-bottom:22px}
.dseo .climb-item{margin-bottom:18px}
.dseo .climb-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:7px}
.dseo .climb-kw{font-size:13px;color:#cbd5e1}.dseo .climb-vol{font-family:var(--mono);font-size:12px;color:#fff;font-weight:600}
.dseo .climb-bar-wrap{height:8px;background:rgba(255,255,255,.07);border-radius:4px;overflow:hidden}
.dseo .climb-bar{height:100%;border-radius:4px;background:linear-gradient(90deg,var(--blue),var(--sky-l))}
.dseo .climb-meta{display:flex;justify-content:space-between;margin-top:4px}
.dseo .climb-kd{font-family:var(--mono);font-size:10px}
.dseo .kd-easy{color:#34d399}.dseo .kd-med{color:#fbbf24}
.dseo .elev-compare{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:22px}
.dseo .elev-box{border-radius:12px;padding:15px;text-align:center}
.dseo .elev-box.now{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08)}
.dseo .elev-box.target{background:rgba(37,99,235,.12);border:1px solid rgba(59,130,246,.3)}
.dseo .elev-box-num{font-family:var(--disp);font-size:23px;font-weight:800}
.dseo .elev-box.now .elev-box-num{color:#94a3b8}.dseo .elev-box.target .elev-box-num{color:var(--sky-l)}
.dseo .elev-box-label{font-size:11px;margin-top:4px}.dseo .elev-box.now .elev-box-label{color:#64748b}.dseo .elev-box.target .elev-box-label{color:#bfdbfe}

/* BLUF */
.dseo .bluf{background:var(--cream)}
.dseo .bluf-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;margin-top:36px}
.dseo .bluf-card{background:var(--paper);border:1px solid var(--line);border-radius:18px;padding:30px;position:relative;overflow:hidden;box-shadow:var(--sh-card)}
.dseo .bluf-card:before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,var(--blue),var(--sky-l))}
.dseo .bluf-num{font-family:var(--disp);font-size:46px;font-weight:800;line-height:1;margin-bottom:8px;color:var(--blue);font-variant-numeric:tabular-nums}
.dseo .bluf-num.s2{color:var(--sky)}.dseo .bluf-num.s3{color:var(--blue-d)}
.dseo .bluf-title{font-family:var(--disp);font-weight:700;font-size:16px;margin-bottom:7px}
.dseo .bluf-desc{font-size:14px;color:var(--n600);line-height:1.6}
.dseo .answer{margin-top:34px;max-width:880px;font-size:17px;line-height:1.7;color:var(--ink)}
.dseo .answer b{color:var(--blue-d)}
.dseo .byline{display:flex;align-items:center;gap:10px;margin-top:22px;font-family:var(--mono);font-size:12.5px;color:var(--n600);letter-spacing:.02em}
.dseo .byline-dot{width:7px;height:7px;border-radius:50%;background:var(--blue);flex-shrink:0}

/* MARKET (dark): maxi stats + narrative + image */
.dseo .market{background:var(--navy);color:var(--ct)}
.dseo .market .eyebrow{color:var(--sky-l)}.dseo .market h2{color:#fff}
.dseo .mstats{display:grid;grid-template-columns:repeat(4,1fr);gap:26px;margin:8px 0 56px;border-bottom:1px solid rgba(255,255,255,.08);padding-bottom:48px}
.dseo .mstat .mv{font-family:var(--disp);font-size:clamp(44px,5.4vw,72px);font-weight:800;line-height:1;background:linear-gradient(135deg,var(--sky-l),var(--blue));-webkit-background-clip:text;-webkit-text-fill-color:transparent;font-variant-numeric:tabular-nums}
.dseo .mstat .mk{margin-top:10px;font-size:14px;color:#cbd5e1;line-height:1.4}
.dseo .mstat .msrc{display:block;margin-top:6px;font-family:var(--mono);font-size:10.5px;color:var(--ct-mut);letter-spacing:.04em}
.dseo .market-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:52px;align-items:center}
.dseo .market-grid p{color:#cbd5e1;font-size:16px;line-height:1.78;margin-top:16px}
.dseo .market-grid p b{color:#fff}
.dseo .ph-img{border-radius:18px;overflow:hidden;border:1px solid rgba(255,255,255,.1);box-shadow:0 24px 60px rgba(0,0,0,.4)}
.dseo .ph-img img{width:100%;height:auto;display:block}
.dseo .img-cap{font-family:var(--mono);font-size:11px;color:var(--ct-mut);margin-top:10px;letter-spacing:.03em}

/* INDUSTRY TABS (CSS-only) */
.dseo .tabs-sec{background:var(--cream)}
.dseo .tabs>input{position:absolute;opacity:0;pointer-events:none;width:0;height:0}
.dseo .tabbar{display:flex;flex-wrap:wrap;gap:8px;margin-top:32px}
.dseo .tab-label{font-family:var(--mono);font-size:12.5px;letter-spacing:.02em;padding:10px 18px;border-radius:999px;border:1px solid var(--line-d);background:var(--paper);color:var(--n600);cursor:pointer;transition:all .15s}
.dseo .tab-label:hover{border-color:var(--blue);color:var(--blue)}
.dseo .tab-panel{display:none;margin-top:30px;grid-template-columns:.9fr 1.1fr;gap:40px;align-items:center}
.dseo .tab-h3{font-family:var(--disp);font-size:23px;font-weight:800;color:var(--ink)}
.dseo .tab-chips{display:flex;flex-wrap:wrap;gap:10px;margin:14px 0 16px}
.dseo .tab-chip{font-family:var(--mono);font-size:11px;padding:6px 12px;border-radius:6px;background:var(--blue-soft);color:var(--blue-d)}
.dseo .tab-body{font-size:15px;line-height:1.72;color:var(--n600)}
.dseo .tab-img{border-radius:16px;overflow:hidden;border:1px solid var(--line);box-shadow:var(--sh-card)}.dseo .tab-img img{width:100%;height:auto;display:block}
.dseo .tab-ph{aspect-ratio:8/5;background:linear-gradient(135deg,var(--blue-soft),var(--paper));border:1px solid var(--line);border-radius:16px;display:flex;align-items:center;justify-content:center;text-align:center;padding:24px}
.dseo .tab-ph span{font-family:var(--mono);font-size:11px;color:var(--n600);line-height:1.6}
.dseo #dt-restaurants:checked~.panels .p-restaurants,.dseo #dt-realestate:checked~.panels .p-realestate,.dseo #dt-contractors:checked~.panels .p-contractors,.dseo #dt-legal:checked~.panels .p-legal,.dseo #dt-cannabis:checked~.panels .p-cannabis,.dseo #dt-tech:checked~.panels .p-tech,.dseo #dt-healthcare:checked~.panels .p-healthcare{display:grid}
.dseo #dt-restaurants:checked~.tabbar label[for=dt-restaurants],.dseo #dt-realestate:checked~.tabbar label[for=dt-realestate],.dseo #dt-contractors:checked~.tabbar label[for=dt-contractors],.dseo #dt-legal:checked~.tabbar label[for=dt-legal],.dseo #dt-cannabis:checked~.tabbar label[for=dt-cannabis],.dseo #dt-tech:checked~.tabbar label[for=dt-tech],.dseo #dt-healthcare:checked~.tabbar label[for=dt-healthcare]{background:var(--blue);border-color:var(--blue);color:#fff}

/* KEYWORD TABLE */
.dseo .kwtable-sec{background:var(--paper)}
.dseo .kwtable-wrap{margin-top:32px;border-radius:16px;overflow:hidden;border:1px solid var(--line);overflow-x:auto}
.dseo table.kwt{width:100%;border-collapse:collapse;font-size:14px;min-width:640px}
.dseo .kwt thead th{background:var(--navy);color:#fff;font-family:var(--mono);font-size:11px;letter-spacing:.07em;text-transform:uppercase;text-align:left;padding:14px 20px}
.dseo .kwt tbody td{padding:13px 20px;border-top:1px solid var(--line);color:var(--ink)}
.dseo .kwt tbody tr:nth-child(odd){background:var(--cream)}
.dseo .kwt .kw{font-weight:600}.dseo .kwt .vol{font-family:var(--mono)}
.dseo .kd-pill{font-family:var(--mono);font-size:11px;padding:3px 9px;border-radius:5px;white-space:nowrap}
.dseo .kd-pill.easy{background:var(--green-soft);color:var(--green)}
.dseo .kd-pill.low{background:var(--blue-soft);color:var(--blue-d)}
.dseo .kd-pill.med{background:var(--amber-soft);color:var(--amber-d)}
.dseo .kwt-foot{font-size:13px;color:var(--n600);margin-top:14px}

/* SERVICES */
.dseo .services{background:var(--cream)}
.dseo .svc-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:36px}
.dseo .svc-row{background:var(--paper);border:1px solid var(--line);border-radius:16px;padding:26px;display:flex;gap:18px;align-items:flex-start;transition:box-shadow .2s,transform .2s}
.dseo .svc-row:hover{box-shadow:var(--sh-card);transform:translateY(-2px)}
.dseo .svc-num{font-family:var(--mono);font-size:11px;color:var(--blue);font-weight:700;min-width:26px;padding-top:2px}
.dseo .svc-info h3{font-family:var(--disp);font-weight:700;font-size:16px;margin-bottom:6px}
.dseo .svc-info p{font-size:14px;color:var(--n600);line-height:1.6}

/* TIMELINE (dark) */
.dseo .timeline-sec{background:var(--navy2)}.dseo .timeline-sec .eyebrow{color:var(--sky-l)}.dseo .timeline-sec h2{color:#fff}
.dseo .timeline{display:grid;grid-template-columns:repeat(5,1fr);gap:16px;margin-top:42px;position:relative}
.dseo .tl-line{position:absolute;top:21px;left:6%;right:6%;height:2px;background:linear-gradient(90deg,var(--blue),var(--sky-l),#93c5fd);opacity:.45}
.dseo .tl-step{position:relative;text-align:center}
.dseo .tl-dot{width:44px;height:44px;border-radius:50%;background:var(--navy2);border:2px solid var(--sky-l);color:var(--sky-l);display:flex;align-items:center;justify-content:center;font-family:var(--mono);font-weight:700;font-size:13px;margin:0 auto 14px;position:relative;z-index:2}
.dseo .tl-day{font-family:var(--mono);font-size:11px;color:var(--sky-l);letter-spacing:.06em;text-transform:uppercase;margin-bottom:6px}
.dseo .tl-title{font-family:var(--disp);font-weight:700;font-size:15px;color:#fff;margin-bottom:6px}
.dseo .tl-desc{font-size:13px;color:#cbd5e1;line-height:1.55}

/* RESULTS (dark) */
.dseo .results{background:var(--navy)}.dseo .results .eyebrow{color:var(--sky-l)}.dseo .results h2{color:#fff}
.dseo .results-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:52px;align-items:center}
.dseo .results-grid p{color:#cbd5e1;font-size:16px;line-height:1.78;margin-top:16px}

/* COMPARISON */
.dseo .comparison{background:var(--cream)}
.dseo .comp-table{margin-top:36px;border-radius:16px;overflow:hidden;border:1px solid var(--line)}
.dseo .comp-head,.dseo .comp-row{display:grid;grid-template-columns:1.1fr 1fr 1fr}
.dseo .comp-head{background:var(--navy)}
.dseo .ch{padding:16px 22px;font-family:var(--disp);font-weight:700;font-size:15px}
.dseo .ch.label{color:#94a3b8}.dseo .ch.them{color:#cbd5e1}.dseo .ch.us{color:var(--sky-l)}
.dseo .comp-row{border-top:1px solid var(--line);background:var(--paper)}
.dseo .comp-row:nth-child(odd){background:var(--cream)}
.dseo .cr{padding:15px 22px;font-size:14px}
.dseo .cr.label{color:var(--ink);font-weight:600}.dseo .cr.them{color:var(--n600)}.dseo .cr.us{color:var(--ink);font-weight:500}
.dseo .check{color:var(--green);font-weight:700}.dseo .cross{color:#b91c1c;font-weight:700}

/* FOUNDER / PROOF */
.dseo .founder{background:var(--paper)}
.dseo .founder-card{background:linear-gradient(135deg,var(--navy) 0%,#16223D 100%);border-radius:24px;padding:46px;display:grid;grid-template-columns:190px 1fr 320px;gap:38px;align-items:center;border:1px solid rgba(255,255,255,.07)}
.dseo .founder-photo{border-radius:16px;overflow:hidden;border:1px solid rgba(255,255,255,.12)}.dseo .founder-photo img{width:100%;height:auto;aspect-ratio:1;object-fit:cover;display:block}
.dseo .founder-tag{font-family:var(--mono);font-size:11px;letter-spacing:.1em;color:var(--sky-l);text-transform:uppercase;display:block;margin-bottom:12px}
.dseo .founder-headline{font-family:var(--disp);font-size:25px;font-weight:800;color:#fff;line-height:1.22;margin-bottom:12px}
.dseo .founder-bio{font-size:14.5px;color:#cbd5e1;line-height:1.72;margin-bottom:18px}
.dseo .clients{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:14px}
.dseo .clients span{font-size:12.5px;color:#cbd5e1;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);border-radius:7px;padding:6px 11px}
.dseo .real{font-size:13px;color:var(--ct-mut);line-height:1.55}
.dseo .trust-chips{display:flex;gap:10px;flex-wrap:wrap;margin-top:14px}
.dseo .trust-chip{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);border-radius:8px;padding:8px 13px;font-size:13px;color:#cbd5e1;font-weight:500}
.dseo .trust-chip b{color:var(--sky-l);font-weight:700}
.dseo .founder-cta-col{display:flex;flex-direction:column;gap:12px;text-align:center}
.dseo .founder-cta-col .micro{font-size:12px;color:var(--ct-mut)}

/* FAQ - canonical .faqnav + details (shared pattern) */
.dseo .faq{background:var(--cream)}
.dseo .faq .lead{max-width:620px}
.dseo .faqgrid{display:grid;grid-template-columns:230px 1fr;gap:48px;margin-top:40px}
.dseo .faqnav{position:sticky;top:92px;display:flex;flex-direction:column;gap:1px;height:fit-content}
.dseo .faqnav a{display:flex;justify-content:space-between;gap:10px;align-items:center;padding:10px 14px;border-left:2px solid transparent;color:var(--n600);font-weight:600;font-size:14.5px;text-decoration:none;transition:color .2s,border-color .2s}
.dseo .faqnav a:hover{color:var(--blue);border-left-color:var(--blue)}
.dseo .faqnav a .ct{font-family:var(--mono);font-size:11px;color:var(--n400)}
.dseo .faqcat{margin-bottom:30px;scroll-margin-top:90px}
.dseo .faqcat-h{display:flex;align-items:center;gap:10px;margin-bottom:10px}
.dseo .faqcat-bar{width:22px;height:2px;background:var(--blue)}
.dseo .faqcat-l{font-family:var(--mono);font-size:.68rem;letter-spacing:.12em;text-transform:uppercase;color:var(--blue-d)}
.dseo details{background:var(--paper);border:1px solid var(--line);border-radius:13px;padding:2px 20px;margin:0 0 10px;transition:border-color .2s}
.dseo details[open]{border-color:var(--line-d);box-shadow:var(--sh-card)}
.dseo summary{cursor:pointer;font-family:var(--disp);font-weight:700;font-size:16.5px;padding:15px 0;list-style:none;display:flex;justify-content:space-between;gap:16px;align-items:center;color:var(--ink)}
.dseo summary::-webkit-details-marker{display:none}
.dseo summary:after{content:"+";font-family:var(--disp);font-size:22px;color:var(--blue-d);flex-shrink:0;transition:transform .2s}
.dseo details[open] summary{color:var(--blue)}
.dseo details[open] summary:after{content:"\2212"}
.dseo details p{font-size:14.5px;color:var(--n600);line-height:1.75;padding:0 0 18px}

/* FOOTER CTA (dark) */
.dseo .footer-cta{background:linear-gradient(135deg,var(--navy) 0%,#16223D 100%);text-align:center;position:relative;overflow:hidden}
.dseo .footer-cta:before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at 50% 40%,rgba(37,99,235,.18) 0%,transparent 60%);pointer-events:none}
.dseo .footer-cta h2{color:#fff;font-size:clamp(30px,4vw,44px);margin-bottom:12px;position:relative}
.dseo .footer-cta p{color:#cbd5e1;font-size:17px;margin-bottom:26px;position:relative}
.dseo .footer-cta .cta-row{justify-content:center;position:relative}

/* MOTION GUARD */
@media (prefers-reduced-motion:reduce){.dseo .orb-1,.dseo .orb-2,.dseo .dot-pulse{animation:none!important}}

/* RESPONSIVE */
@media (max-width:980px){
  .dseo .hero-inner,.dseo .market-grid,.dseo .results-grid,.dseo .tab-panel,.dseo .founder-card{grid-template-columns:1fr}
  .dseo #dt-restaurants:checked~.panels .p-restaurants,.dseo #dt-realestate:checked~.panels .p-realestate,.dseo #dt-contractors:checked~.panels .p-contractors,.dseo #dt-legal:checked~.panels .p-legal,.dseo #dt-cannabis:checked~.panels .p-cannabis,.dseo #dt-tech:checked~.panels .p-tech,.dseo #dt-healthcare:checked~.panels .p-healthcare{grid-template-columns:1fr}
  .dseo .mstats{grid-template-columns:1fr 1fr;gap:30px}
  .dseo .bluf-grid,.dseo .svc-grid{grid-template-columns:1fr 1fr}
  .dseo .timeline{grid-template-columns:1fr;gap:22px}.dseo .tl-line{display:none}
  .dseo .faqgrid{grid-template-columns:1fr;gap:22px}.dseo .faqnav{flex-direction:row;flex-wrap:wrap;position:static}
  .dseo .founder-card{text-align:center}.dseo .founder-photo{max-width:190px;margin:0 auto}
}
@media (max-width:560px){
  .dseo .wrap,.dseo .hero-inner{padding:0 20px}
  .dseo .mstats,.dseo .bluf-grid,.dseo .svc-grid,.dseo .comp-head,.dseo .comp-row{grid-template-columns:1fr}
  .dseo .comp-head{display:none}.dseo .cr{border-top:1px solid var(--line)}
}
