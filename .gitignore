node_modules/

# Build output
dist/
.next/
out/

# Environment files
.env
.env.local
.env.*.local

# Research API dumps (regenerable via pipeline/research/dfs_*.py; ~34MB)
pipeline/research/data/raw/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Firebase
.firebase/

# Next.js
next-env.d.ts
.vercel
tsconfig_noext.json

# Brand audit pipeline (Patch #5)
pipeline/scripts/.venv/
# Tracking health-check venv (206 MB, built by scripts/setup-tracking-venv.sh).
# Never commit: it is machine-specific and rebuildable in one command.
.venv-tracking/
pipeline/scripts/__pycache__/
pipeline/scripts/*.pyc
pipeline/research/__pycache__/
pipeline/research/*.pyc
pipeline/brand-references/*/screenshots/
pipeline/brand-references/_run.log
.claude/*
# Everything under .claude/ stays local EXCEPT the content-hygiene skill, which
# pairs with scripts/check-watermarks.mjs and has to travel with the repo.
# The pattern must be `.claude/*` and not `.claude/`: git cannot re-include a
# path whose parent directory is itself excluded, so a bare `.claude/` would
# make every negation below a silent no-op. Same reason for re-excluding
# `.claude/skills/*` before naming the one skill we do track.
!.claude/skills/
.claude/skills/*
!.claude/skills/clean-user-facing-text/
.claude/skills/clean-user-facing-text/**/__pycache__/
yadav-preview/

# Netlify deploy artifacts
deploy-*.zip

# Client project files (not part of FactoryJet website source)
yadav-*.html
yadav-*.docx
Yadav-*.docx
convert-images.sh

# TypeScript incremental build cache
tsconfig.tsbuildinfo

# FUSE mount artifacts (Cowork sandbox)
.fuse_hidden*
