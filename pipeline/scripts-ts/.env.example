# Firebase Admin SDK credentials path
# Default if unset: ~/.factoryjet/firebase-admin-pipeline.json
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-admin-pipeline.json

# Firebase project ID (default: factoryjet-pipeline)
# FIREBASE_PROJECT_ID=factoryjet-pipeline

